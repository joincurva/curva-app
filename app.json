{
  "expo": {
    "name": "Curva",
    "owner": "joincurva",
    "slug": "curva",
    "scheme": "curva",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon-1024.png",
    "ios": {
      "bundleIdentifier": "com.joincurva.curva",
      "buildNumber": "1",
      "supportsTablet": false,
      "deploymentTarget": "16.4",
      "associatedDomains": [
        "applinks:joincurva.com",
        "webcredentials:joincurva.com"
      ],
      "infoPlist": {
        "UIBackgroundModes": [],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B1633"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "extra": {
      "environment": "production",
      "apiUrl": "https://joincurva.com",
      "eas": {
        "projectId": "b7a63ad8-18de-479a-b1a9-9ea0a8c1a7c1"
      },
      "pushDeliveryEnabled": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
