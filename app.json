{
  "expo": {
    "name": "Curva",
    "owner": "joincurva",
    "slug": "curva",
    "scheme": "curva",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon-1024.png",
    "ios": {
      "bundleIdentifier": "com.joincurva.curva",
      "buildNumber": "1",
      "supportsTablet": false,
      "deploymentTarget": "16.4",
      "associatedDomains": [
        "applinks:joincurva.com",
        "webcredentials:joincurva.com"
      ],
      "infoPlist": {
        "UIBackgroundModes": [],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B1633"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Curva uses your location to show concerts, games and shows near you. It's only used for your search and never stored."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/manrope-400.ttf",
            "./assets/fonts/manrope-500.ttf",
            "./assets/fonts/manrope-600.ttf",
            "./assets/fonts/manrope-700.ttf",
            "./assets/fonts/manrope-800.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "environment": "production",
      "apiUrl": "https://joincurva.com",
      "eas": {
        "projectId": "b7a63ad8-18de-479a-b1a9-9ea0a8c1a7c1"
      },
      "pushDeliveryEnabled": true,
      "appleSignIn": false
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
